generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Emit .js import paths so the compiled output runs on plain Node (ESM).
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Uppercase names in code; @map keeps the lowercase values from the spec in the database.
enum TicketStatus {
  OPEN        @map("open")
  IN_PROGRESS @map("in_progress")
  CLOSED      @map("closed")
}

enum TicketPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
}

model Ticket {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(200)
  description String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("tickets")
}
